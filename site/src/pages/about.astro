// About: why the site exists, how it is made, who does what, and what is not known yet. The
// last part is drawn from docs/open-questions.md, in plain words. Nothing on this page closes
// one of those questions.
// The section on who does what: ruled by John on 2026-11-18
// (docs/rulings/2026-11-18-how-the-site-declares-ai-authorship.md) that it is in his own first
// person, and that its conflict paragraph names the developer of the drafting model and no
// model. Not ruled: the sentences themselves. They are a session's draft of 2026-11-18, and
// John reads and owns each first-person sentence before release
// (docs/first-version-choices.md, choice 5). The rest of the page stays impersonal.
// The first person is kept inside the block marked id="who", and scripts/check_site.py refuses
// it anywhere else but the notice.
// What "offered today" means was ruled by John on 2026-11-18
// (docs/rulings/2026-11-18-what-offered-today-means.md). The words here are a session's fitting
// of that meaning to the page, and are not ruled.
import Base from '../layouts/Base.astro';
import { data, headline, longDate, QUESTION } from '../lib/data';

const r = data.headline.records;
// The developer of the model that drafted the text. This is the one place on the site, outside
// the entries, where a developer is named, and scripts/check_site.py allows the name in the
// paragraph marked id="conflict" and nowhere else off an entry's page.
const DRAFTER = { name: 'Anthropic', url: 'https://www.anthropic.com/' };
// How many of the things counted as offered rest on that developer alone. Worked out here from
// the export, so the sentence that uses it cannot drift from the records.
const counted = data.entries.filter((e) => e.state.offered_today === true);
const byDrafterAlone = counted.filter((e) => e.state.offered_by.length === 1 && e.state.offered_by[0].name === DRAFTER.name).length;
// "all 5" when every counted thing rests on that developer alone, "4 of the 5" when not.
const restOnDrafter = byDrafterAlone === headline.count ? `all ${headline.count}` : `${byDrafterAlone} of the ${headline.count}`;
// The sentence says "several entries", so the build stops if the records stop bearing it out.
if (counted.filter((e) => e.state.offered_by.some((d) => d.name === DRAFTER.name)).length < 3) throw new Error('the conflict paragraph says "several entries", and the records no longer show several');
// Where the first two cautions come from. John ruled on 2026-11-19 that the About page says it in
// one statement (docs/rulings/2026-11-19-ties-between-sources-told-in-both-places.md); the
// sentence is a session's draft of that day and is PROPOSED. It says "most" twice, so the build
// stops if the records stop bearing either "most" out.
const under = (kind: string) => data.entries.flatMap((e) => (e.cautions.find((c) => c.kind === kind)?.items ?? []).map((it) => e.sources.find((s) => s.key === it.source)!.url));
const share = (urls: string[], from: RegExp) => urls.filter((u) => from.test(u)).length / Math.max(1, urls.length);
// The first caution: the essays by the head of another developer's AI group.
if (share(under('attribution'), /^https:\/\/mustafa-suleyman\.ai\//) <= 0.5) throw new Error('the conflict paragraph says most of the first caution comes from one writer, and the records no longer show it');
// The second: the research group's own pages; papers and essays by its head, its advisors, or
// people who have written a report with its head; and a study by people at the drafting model's
// developer. Each tie is stated on the entry that uses the source.
const CIRCLE = /eleosai\.org|experiencemachines\.substack\.com|arxiv\.org\/abs\/(2411\.00986|2311\.08576|2507\.06263|2506\.11945|2509\.04781)|a-philosophers-guide-to-ai-welfare|ai-consciousness-a-centrist-manifesto|meditationsondigitalminds/;
if (share(under('unnoticed'), CIRCLE) <= 0.5) throw new Error('the conflict paragraph says most of the second caution comes from one circle, and the records no longer show it');
// The general statement of the two mistakes, ruled by John on 2026-11-19
// (docs/rulings/2026-11-19-general-statement-of-both-mistakes.md, "Yes, from those two"). Both
// papers were read in full on 2026-11-19 before the sentences were written. The sentences are a
// session's draft and are PROPOSED.
