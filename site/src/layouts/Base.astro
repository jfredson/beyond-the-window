---
// The page shell, as the family's design standard sets it (sections 6 to 8): the theme set
// before first paint, the top bar, and the footer with its lines. Adapted from The Upgrade
// Tree's Base.astro (its main branch) on 2026-11-17.
//
// Three things differ from the siblings, each a provisional choice in
// docs/first-version-choices.md:
// - the theme follows the visitor's own light or dark setting, with no default (choice 4);
// - the attribution line carries no licence words, because whether the family's licence suits
//   this project has not been decided (choice 15);
// Until 2026-11-19 every page also asked search engines not to list it. That line is gone, so
// that the site can be listed as the sibling sites are (John's standing principle of that day is
// to copy the siblings wherever possible, docs/rulings/2026-11-19-three-points-on-the-first-release.md).
// Only the page for a missing address still asks to be left out, as on The Quiet Galaxy. The
// page's own address and the text a link preview reads were added the same day, in The Quiet
// Galaxy's form. The preview picture and the feed of acts were added on 2026-11-20.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { data, longDate, builtFrom, SITE_NAME } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean; // the page for a missing address only
}

const {
  title = SITE_NAME,
  description = 'A dated record of how the world is treating AI models: what developers, lawmakers and researchers have done, by whom and when.',
  noindex = false,
} = Astro.props;

// The picture a link preview shows and the feed of acts, on every page since 2026-11-20. The
// picture holds no figure (scripts/preview_picture.sh), so it does not go out of date.
const image = '/preview.png';
const feed = '/acts.xml';

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash. A stored choice wins; otherwise the visitor's own setting decides. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#141826" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Andrew Fredrickson" />
    <link rel="author" href="https://johnandrewfredrickson.com/" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/atom+xml" title={`${SITE_NAME}: every act, by date`} href={feed} />
  </head>
  <body>
    {data.constructed && (
      <div class="constructed-banner">Constructed example, not real data · every entry, state and source on this page is made up</div>
    )}
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">Beyond the Window</span>
          <p class="footer-tag">A dated record of how the world is treating AI models: what developers, lawmakers and researchers have done, by whom and when.</p>
          <p class="footer-links">
            <a href="/list/">The list</a>
            <a href="/acts/">Everything, by date</a>
            <a href="/acts.xml">Feed</a>
            <a href="/still-asking/">Still Asking</a>
            <a href="/about/">About</a>
            <a href="/about/#not-known">What is not known yet</a>
            <a href="/data/headline.json">The figures as a file</a>
          </p>
          <p class="footer-meta">
            © {currentYear} <a href="https://johnandrewfredrickson.com/" rel="author">John Andrew Fredrickson</a>. Last built {longDate(data.exported_on)}{data.commit ? ` (version ${data.commit})` : ''} from {builtFrom()}.
          </p>
          <p class="footer-parent"><a href="https://sentient-horizons.com/projects/" rel="noopener">A Sentient Horizons project.</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
