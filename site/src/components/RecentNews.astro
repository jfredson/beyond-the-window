---
// "Recent news" beside a news post (John, 2026-11-14, on the sibling sites), copied on 2026-11-21
// from Outrunning Ageing's site/src/components/RecentNews.astro: the newest dated posts on the
// site, leaving out the one being read, so a visitor who lands on one post can find the others.
// The opening post is left out of the list and offered underneath, except on the opening post
// itself. With nothing to list it shows nothing.
import { longDate } from '../lib/data';
import { datedPosts, opener, postPath } from '../lib/news';

interface Props { currentId: string; count?: number }
const { currentId, count = 5 } = Astro.props;

const recent = (await datedPosts()).filter((p) => p.id !== currentId).slice(0, count);
const startHere = await opener();
const showStart = startHere && startHere.id !== currentId;
---

{recent.length > 0 && (
  <nav class="side-news recent-news" aria-labelledby="recent-news-title">
    <div class="side-news-head">
      <h2 id="recent-news-title">Recent news</h2>
    </div>
    <ul class="side-news-list">
      {recent.map((p) => (
        <li>
          <p class="side-news-meta"><time datetime={p.data.date}>{longDate(p.data.date)}</time></p>
          <a class="side-news-title" href={postPath(p)}>{p.data.title}</a>
        </li>
      ))}
    </ul>
    <p class="side-news-foot"><a href="/news/">All news</a>{showStart && <> · New here? <a href={postPath(startHere!)}>Start with the opening post</a>.</>}</p>
  </nav>
)}
