---
// The home page, rebuilt (2026-11-20), and since the same day opened by the headline number
// again (see below; a draft, not published). John ruled that day to pursue the rebuild, to name every
// developer the record covers, and that the record covers three; and gave his go to publish
// once a different session has checked the page
// (docs/rulings/2026-11-20-go-to-publish-the-rebuilt-home-page-once-checked.md). Design:
// docs/proposals/2026-11-20-rebuild-design.md. Which form of the page this is, and every
// sentence on it, is a session's choice and not John's (the same ruling lists them).
//
// Every figure is read from the readings scripts/compute.py wrote, and each is marked with
// data-figure so that scripts/check_site.py can compare it with the served file. No figure is
// typed.
//
// Developers are named in the developers' reading and nowhere else on this page: the three
// boxes near the top and the table under "Who does what", both marked data-developers-reading.
// The dated list below prints a developer's act as "A developer ...".
import Base from '../layouts/Base.astro';
import WindowGrid from './WindowGrid.astro';
import ThingList from './ThingList.astro';
import ActList from './ActList.astro';
import '../styles/rebuild.css';
import { data, headline, readings, entryById, longDate, worldDate, countWord, QUESTION } from '../lib/data';


if (!readings) throw new Error('the headline file holds no readings; run scripts/compute.py');
const r = data.headline.records;
const g = readings.developers;
const law = readings.law;
const pub = readings.public;
const res = readings.researchers;
const latest = readings.latest;
const lastRead = data.headline.last_read;
if (!law.against || !law.protecting || !pub || !res || !latest) throw new Error('a reading is missing');
if (res.measures.length !== 2) throw new Error('the researchers\' reading is written for two figures');

// The top of the page opens with the headline number, as the sibling sites' home pages do
// (John's ruling of 2026-11-20, docs/rulings/2026-11-20-home-page-opens-with-a-headline-again.md).
// The number is the count worked out by scripts/compute.py and read from the headline file,
// never typed, with no total beside it (ruled 2026-11-18). Two versions of the words are drawn
// for John to choose between (docs/proposals/2026-11-20-headline-draft.md); the build picks one
// with HEADLINE_VERSION:
//   A  the sentence John ruled on 2026-11-19, word for word, as the headline file holds it
//   B  a plainer sentence for the same count, PROPOSED 2026-11-20 and not ruled, with a line
//      naming three of the things counted and the count broken down by developer
// Neither sentence is ruled for this layout; the layout itself is a draft.
interface Props { version?: 'A' | 'B' }
const { version = 'A' } = Astro.props;
if (version !== 'A' && version !== 'B') throw new Error(`no headline version '${version}'`);
const h = headline;
if (!h.words.startsWith(`${h.count} `)) throw new Error('the headline sentence does not open with the count');
const ruledClaim = h.words.slice(`${h.count} `.length) + '.';
// Version B names three of the things counted. Each must be counted, or the build stops.
const NAMED = ['kept-files-of-retired-models', 'interview-before-retirement', 'ending-a-conversation'];
for (const id of NAMED) if (!h.offered_ids.includes(id)) throw new Error(`version B names '${id}', which is not counted`);
// Version B's breakdown: how many of the counted things each covered developer does, most first,
// without the developers' names (the names stand in the developers' reading below, the only
// place on this page the site check allows them).
const ORDINALS = ['one developer', 'a second', 'a third', 'a fourth', 'a fifth'];  // the last is printed 'the third this record covers'
const byCount = [...readings!.developers.by_developer].sort((a, b) => b.offered - a.offered);
if (byCount.length > ORDINALS.length) throw new Error('the breakdown is written for five developers at most');
if (byCount[0].offered > h.count) throw new Error('a developer does more things than are counted');

const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const things = (n: number) => (n === 1 ? '1 thing' : `${n} things`);
const cellWords = (kind: string, date: string | null, words?: string) =>
  kind === 'offered' ? `Since ${date ? worldDate(date) : 'a date not recorded'}`
  : kind === 'unruled' ? `${worldDate(date!)}: ${words}. Whether this counts is not decided yet.`
  : kind === 'not_counted' && words ? `${worldDate(date!)}: ${words}. Not counted.`
  : kind === 'not_counted' ? `${worldDate(date!)}, not counted as offered`
  : kind === 'taken_back' ? `Withdrawal: ${worldDate(date!)}`
  : kind === 'nothing_found' ? `Nothing found on ${worldDate(date!)}`
  : 'Not yet searched';
const actSentence = (a: typeof latest) => `${a.actor_kind === 'developer' ? 'A developer' : a.actor} ${a.words}.`;
---

<Base>
  <div class="rb-first">
  <div class="rb-top hl-top" data-headline-version={version}>
    <p class="eyebrow">A dated record of how the world is treating AI models</p>
    <p class="big-number"><span data-figure="headline.count">{h.count}</span></p>
    {version === 'A' ? (
      <p class="big-claim">{ruledClaim}</p>
    ) : (
      <Fragment>
        <p class="big-claim">things a developer can do for the AI models it builds are done, or publicly committed to, by at least one developer today.</p>
        <p class="hl-among">Among them: <a href="/list/kept-files-of-retired-models/">keeping a retired model's files</a>, <a href="/list/interview-before-retirement/">interviewing a model before retiring it</a>, and <a href="/list/ending-a-conversation/">letting a model end a conversation</a>.</p>
        <div class="stage-row" aria-label={`How many of the ${h.count} each developer this record covers does`}>
          {byCount.map((d, i) => (
            <div>
              <span class="stat"><span data-figure={`developers.${d.name}.offered`}>{d.offered}</span></span>
              <span class="stat-label">by {i === byCount.length - 1 && i > 0 ? `the ${ORDINALS[i].replace(/^a /, '')} this record covers` : ORDINALS[i]}</span>
            </div>
          ))}
        </div>
      </Fragment>
    )}
    <h1 class="question">{QUESTION}</h1>
    <p class="lede">This record holds what has been done about AI models, by whom and when, each with a source a reader can open.</p>
    <ul class="checked">
      {lastRead && <li class="world">The world's record was last read on {longDate(lastRead)}. All {r.total} entries are a first pass. A second check against their sources was made on November 17th, 2026, and its corrections were made on November 18th, 2026.</li>}
      <li class="world">The dated acts, the survey figures and the searches were written in on November 20th, 2026, each from a source or a search made that day. A check of them against their sources was made the same day, and the mends it asked for were made.</li>
    </ul>
    <div class="ctas">
      <a class="btn" href="#list">Read the list</a>
      <a class="btn ghost" href="/still-asking/">What AI models have been asked</a>
    </div>
  </div>

  <div class="rb-top rb-side">
    <div class="rb-readings">
      <p class="rb-reading rb-row">
          <span class="rb-fig"><span data-figure="researchers.0">{res.measures[0].value}</span>%</span>
          <span><span class="rb-label">Researchers</span>{res.measures[0].words}. <span data-figure="researchers.1">{res.measures[1].value}</span>% {res.measures[1].words}. {res.one_source && 'From one survey. '}<a href={`/list/${res.entry}/`}>More on this survey.</a></span>
      </p>
      <div class="rb-reading rb-devs">
        <span class="rb-label">Developers</span>
        <p>This record follows <span data-figure="developers.things">{countWord(g.things)}</span> things a developer can do for the AI models it builds{version === 'A' && ", such as keeping a retired model's files or letting a model end a conversation"}. It covers <span data-figure="developers.covered">{countWord(g.covered.length)}</span> developers so far. Other developers are not covered yet.</p>
        <ul class="rb-strip" data-developers-reading>
          {g.by_developer.map((d) => (
            <li>
              <a href={d.url ?? undefined} rel="noopener">{d.name}</a>
              <span class={d.offered > 0 ? 'has' : ''}>{d.offered > 0 ? <Fragment><span data-figure={`developers.${d.name}.offered`}>{d.offered}</span> in place or promised</Fragment> : 'None counted so far'}</span>
              {d.unruled > 0 && <span class="dim"><span data-figure={`developers.${d.name}.unruled`}>{d.unruled}</span> found, not yet decided</span>}
              {d.not_counted + d.taken_back > 0 && <span class="dim"><span data-figure={`developers.${d.name}.near`}>{d.not_counted + d.taken_back}</span> found, not counted</span>}
              {d.nothing_found > 0 && <span class="dim"><span data-figure={`developers.${d.name}.nothing_found`}>{d.nothing_found}</span> looked for, not found</span>}
              {d.not_searched > 0 && <span class="dim"><span data-figure={`developers.${d.name}.not_searched`}>{d.not_searched}</span> not yet searched</span>}
            </li>
          ))}
        </ul>
        <p class="rb-note">In place or promised means the developer does the thing or has publicly committed to it. Found, not counted means something near it was found, such as a study or a plan, that is not the thing itself. Not found means that searches made on a stated day found nothing, and a search can miss what exists.{g.counts.unruled > 0 && ' Not yet decided means something was found, and whether it counts is open.'}{g.counts.not_searched > 0 && ' Not yet searched means that nobody has looked.'} <a href="#who-does-what">Who does what, thing by thing.</a></p>
      </div>
      <p class="rb-reading rb-row">
        <span class="rb-fig"><span data-figure="law.against.count">{law.against.count}</span></span>
        <span><span class="rb-label">Law</span>United States states have <a href={`/list/${law.against.entry}/`}>a law saying an AI system cannot be a legal person</a>, the first in {worldDate(law.against.first!)} and the newest on {worldDate(law.against.latest!)}. {law.protecting.met ? '' : <Fragment><a href={`/list/${law.protecting.entry}/`}>No law protecting an AI system for its own sake</a> was found when it was looked for on {longDate(law.protecting.looked_on)}.</Fragment>}</span>
      </p>
      <p class="rb-reading rb-row">
        <span class="rb-fig"><span data-figure="public.0">{pub.measures[0].value}</span>%</span>
        <span><span class="rb-label">The public</span>{pub.measures[0].words}. {pub.one_source && 'From one survey. '}<a href={`/list/${pub.entry}/`}>More on this survey.</a></span>
      </p>
      <p class="rb-reading rb-latest"><strong>Latest, {worldDate(latest.date)}:</strong> {actSentence(latest)} <a href="#dated">Everything, by date.</a></p>
    </div>
  </div>
  </div>

  <section class="below" id="who-does-what">
    <div class="shead"><h2>Who does what</h2><span><span data-figure="developers.things">{countWord(g.things)}</span> things a developer can do for its models, <span data-figure="developers.covered">{countWord(g.covered.length)}</span> developers</span></div>
    <p class="intro">
      Each row is one of the <span data-figure="developers.things">{countWord(g.things)}</span> things. Each column is a developer this record covers so
      far. "Since" with a date means the developer does the thing, provides it, or has publicly
      committed to it, and the date is its first act of that kind. Of the
      <span data-figure="developers.cells">{g.cells}</span> places in the table,
      <span data-figure="developers.nothing_found">{g.counts.nothing_found}</span> say nothing
      found. Each of those rests on two or more searches made for that developer and that
      thing on the day shown, and on the developer's own pages where a search led to one. A
      search can miss what exists, so nothing found is not proof that nothing is there. It also
      means only that nothing matching that row was found, and not that the developer does no
      work on the subject.
      {g.counts.unruled > 0 && <Fragment> <span data-figure="developers.unruled">{g.counts.unruled}</span> places say what was found and that whether it counts is not decided yet.</Fragment>}
      {g.counts.not_searched > 0 && <Fragment> <span data-figure="developers.not_searched">{g.counts.not_searched}</span> places have not been searched yet.</Fragment>}
    </p>
    <table class="rb-grid" data-developers-reading>
      <thead>
        <tr>
          <th scope="col">Thing</th>
          {g.by_developer.map((d) => <th scope="col"><a href={d.url ?? undefined} rel="noopener">{d.name}</a></th>)}
        </tr>
      </thead>
      <tbody>
        {g.rows.map((row) => (
          <tr data-entry={row.entry}>
            <th scope="row"><a href={`/list/${row.entry}/`}>{row.name}</a></th>
            {row.cells.map((c) => <td class={`k-${c.kind}`} data-dev={c.developer} data-kind={c.kind} data-date={c.date ?? ''}>{cellWords(c.kind, c.date, c.words)}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="rb-note">
      "Not counted" marks something found that is not the thing itself: a research result, a
      plan, a promise that has not yet taken effect, or a step that only comes near it.
      {g.counts.taken_back > 0 && ' "Withdrawal" marks an act that takes something back.'} Each row's name leads
      to its page, with the sources.
      {!law.protecting.met && <Fragment> One thing on the list is a lawmaker's to do and not a developer's, so it has no row here: <a href={`/list/${law.protecting.entry}/`}>{entryById.get(law.protecting.entry)!.name.charAt(0).toLowerCase() + entryById.get(law.protecting.entry)!.name.slice(1)}</a>. It is counted under Law, above.</Fragment>}
    </p>
  </section>

  <section class="below" id="dated">
    <div class="shead"><h2>Everything, by date</h2><span><span data-figure="acts.count">{readings.acts.length}</span> dated acts, newest first</span></div>
    <ActList />
    <p class="rb-note"><a href="/acts/">The same list on its own page, with who acted and the source for each.</a></p>
  </section>

  <section class="below" id="why">
    <div class="shead"><h2>Why keep this record</h2></div>
    <p class="intro">
      If AI models have no wants, treating them as if they had has a cost. If they have wants and
      nobody notices, that has a cost. If they put people at risk, whether or not they have wants,
      that has a cost too. All three are kept in view here, and none is argued for.
    </p>
  </section>

  <section class="below" id="window">
    <div class="shead"><h2>The window</h2><span>the things on the list, at a glance</span></div>
    <div class="rb-window"><WindowGrid /></div>
  </section>

  <section class="below" id="list">
    <div class="shead"><h2>The List</h2><span>{r.on_the_list} things, and how far the world has got on each</span></div>
    <ThingList />
  </section>

  <section class="below" id="beside">
    <div class="shead"><h2>Beside the List</h2><span>{r.beside_the_list} entries</span></div>
    <p class="intro">
      These entries are kept because they bear on everything on the list. Each group says why it
      sits beside the list.
    </p>
    <ThingList beside />
  </section>
</Base>
