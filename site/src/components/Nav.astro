---
// The top bar, in the shape the family's design standard sets (section 6): the site's name,
// the pages a reader would come for, then Family and the theme switch after a thin rule. It
// folds behind a menu button on a narrow screen. Adapted from The Upgrade Tree's Nav.astro
// (its main branch) on 2026-11-17. Which pages sit here is a provisional choice
// (docs/first-version-choices.md, choice 14).
const path = Astro.url.pathname;
const primary = [
  { href: '/list/', label: 'The List' },
  { href: '/still-asking/', label: 'Still Asking' },
  { href: '/about/', label: 'About' },
];
const secondary = [{ href: 'https://sentient-horizons.com/projects/', label: 'Family' }];
const isActive = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">Beyond the Window</a>
    <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg class="ico-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      <svg class="ico-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <nav class="navlinks" id="site-nav">
      {primary.map((l) => (
        <a href={l.href} class={`nav-primary ${isActive(l.href) ? 'active' : ''}`}>{l.label}</a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      {secondary.map((l) => (
        <a href={l.href} class="nav-secondary" rel="noopener">{l.label}</a>
      ))}
      <button type="button" class="theme-toggle" aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    var btn = header && header.querySelector('.nav-toggle');
    var menu = document.getElementById('site-nav');
    if (!btn || !menu) return;
    function setOpen(open) {
      header.classList.toggle('nav-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () {
      setOpen(!header.classList.contains('nav-open'));
    });
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 820) setOpen(false);
    });
  })();
</script>

<script is:inline>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    var meta = document.getElementById('theme-color-meta');
    var COLORS = { dark: '#141826', light: '#eff1ec' };
    function sync(theme) {
      document.documentElement.dataset.theme = theme;
      if (meta) meta.setAttribute('content', COLORS[theme] || COLORS.dark);
    }
    sync(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
    btn.addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('theme', next); } catch (e) {}
      sync(next);
    });
  })();
</script>
